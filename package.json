{
  "name": "dsh-free-search-ru",
  "version": "0.4.29",
  "description": "Форк dsh-free-search с русским интерфейсом и обновлённой интеграцией Perplexity (Agent API /v1/agent). 12 движков, time filtering, platform_search, web_fetch.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "web-search",
    "duckduckgo",
    "bing",
    "tavily",
    "exa",
    "keenable",
    "firecrawl",
    "parallel",
    "perplexity",
    "search",
    "free"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/da-blackest-funeral/dsh-free-search-ru.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7 || ^0.1.1-rc.2 || ^0.1.2-alpha.2 || ^0.1.3-alpha.2 || ^0.1.5-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7 || ^0.1.1-rc.2 || ^0.1.2-alpha.2 || ^0.1.3-alpha.2 || ^0.1.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "compatibility": {
      "dshReleases": {
        "rc.7": "unknown",
        "rc.8": "unknown",
        "0.1.1-rc.1": "compatible",
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.1": "unknown",
        "0.1.2-alpha.2": "compatible",
        "0.1.2-alpha.3": "compatible",
        "0.1.2-alpha.4": "compatible",
        "0.1.2-alpha.5": "unknown",
        "0.1.2-rc.1": "compatible",
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible"
      }
    }
  }
}
